DB_NAME=relay
DB_USERNAME=relay_user
DB_PASSWORD=change_this_to_a_strong_password
DB_PORT=5432

# Optional: bootstrap an initial platform administrator on application startup.
# Leave blank to disable bootstrap. Never commit actual credentials.
RELAY_ADMIN_EMAIL=
RELAY_ADMIN_PASSWORD=
RELAY_ADMIN_FULL_NAME=

# Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
