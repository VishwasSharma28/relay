erDiagram
    users {
        UUID id PK
        VARCHAR email UK
        VARCHAR role
    }
    projects {
        UUID id PK
        UUID created_by FK
        VARCHAR slug UK
    }
    project_members {
        UUID project_id PK, FK
        UUID user_id PK, FK
        VARCHAR role
    }
    environments {
        UUID id PK
        UUID project_id FK
        VARCHAR slug UK
    }
    resources {
        UUID id PK
        UUID project_id FK
        UUID current_schema_version_id FK
        VARCHAR slug
    }
    resource_schema_versions {
        UUID id PK
        UUID project_id FK
        UUID resource_id FK
        INTEGER version UK
        JSONB schema_definition
    }
    records {
        UUID id PK
        UUID project_id FK
        UUID environment_id FK
        UUID resource_id FK
        JSONB data
    }
    api_keys {
        UUID id PK
        UUID project_id FK
        UUID environment_id FK
        UUID created_by FK
        VARCHAR key_prefix UK
        CHAR key_hash UK
    }
    custom_apis {
        UUID id PK
        UUID project_id FK
        VARCHAR slug
    }
    custom_api_versions {
        UUID id PK
        UUID project_id FK
        UUID custom_api_id FK
        INTEGER version UK
        UUID created_by FK
    }
    project_module_installations {
        UUID project_id PK, FK
        VARCHAR module_key PK
        UUID installed_by FK
    }
    releases {
        UUID id PK
        UUID project_id FK
        INTEGER version UK
        UUID created_by FK
    }
    deployments {
        UUID id PK
        UUID project_id FK
        UUID environment_id FK
        UUID release_id FK
        UUID created_by FK
    }
    project_quotas {
        UUID project_id PK, FK
        INTEGER daily_request_limit
        INTEGER requests_per_minute
    }
    usage_daily {
        UUID project_id PK, FK
        UUID environment_id FK
        DATE day PK
        BIGINT request_count
    }
    usage_minute {
        UUID project_id PK, FK
        TIMESTAMPTZ window_start PK
        INTEGER request_count
    }

